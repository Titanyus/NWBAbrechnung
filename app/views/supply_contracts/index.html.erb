<%= turbo_frame_tag "contract_browser", data: {turbo_action: "replace"} do %>
<div data-controller="contract-browser" data-contract-browser-url-value="<%= plant_supply_contracts_path(@plant) %>" data-contract-browser-query-value="<%= @browser.filters.to_json %>" data-action="click->contract-browser#prepareLink turbo:frame-load->contract-browser#loaded workspace:changed->contract-browser#updated turbo:before-cache@document->contract-browser#remember" class="browser-root">
<div class="page-heading browser-heading"><h1>Vertragsverwaltung</h1><%= link_to "Vertrag anlegen", new_plant_supply_contract_path(@plant), class: "button", data: {turbo_frame: "_top"} %></div>
<%= render "browser_filters" %>
<div class="browser-columns">
<section class="contract-list-pane" aria-label="Vertragsauswahl">
<div class="contract-list-heading"><strong><%= @contract_count %> Verträge</strong>
<%= form_with url: plant_supply_contracts_path(@plant), method: :get, data: {turbo_frame: "contract_browser"} do |form| %>
<% @browser.filters.except("sort", "direction").each do |name, value| %><%= hidden_field_tag name, value %><% end %>
<%= hidden_field_tag :selected_contract_id, @workspace_contract&.id %>
<%= form.label :sort, "Sortierung", class: "sr-only" %><%= form.select :sort, [["Kunde (A–Z)", "customer"], ["Vertragsnummer", "number"], ["Anschluss", "connection"], ["Trasse", "route"], ["Status", "status"], ["Vertragsbeginn", "starts_on"]], selected: @browser.sort, data: {action: "change->contract-browser#sort"} %>
<%= hidden_field_tag :direction, @browser.direction %><noscript><%= form.submit "Sortieren" %></noscript>
<% end %></div>
<div class="contract-list-scroll" data-contract-browser-target="list" data-action="scroll->contract-browser#remember keydown->contract-browser#keyboard" tabindex="0" aria-label="Scrollbare Vertragsliste">
<%= render "browser_items" %><%= render "browser_next" %>
<% if @contracts.empty? %><p class="empty-browser">Keine passenden Verträge gefunden.</p><% end %>
</div></section>
<section class="contract-detail-scroll" aria-label="Vertragsakte" data-contract-browser-target="detail">
<%= turbo_frame_tag "contract_detail" do %>
<% if @workspace_contract %><%= render "workspace", message: nil %><% else %><p class="empty-browser">Vertrag suchen oder neu anlegen. Alle verfügbaren Treffer werden links angezeigt.</p><% end %>
<% end %></section>
</div></div>
<% end %>
