<%= render "master_data/errors", record: @customer %>
<%= form_with url: (@customer.persisted? ? plant_customer_path(@plant, @customer) : plant_customers_path(@plant)), method: (@customer.persisted? ? :patch : :post) do |form| %>
<fieldset <%= "disabled" unless @can_edit_customer %>><legend>Gemeinsame Kundenstammdaten</legend>
<% unless @can_edit_customer %><p>Gemeinsame Daten können nur Mitarbeiter mit Zugriff auf alle Kundenzuordnungen ändern. Die Angaben für diese Anlage bleiben bearbeitbar.</p><% end %>
<%= fields_for :customer, @customer do |c| %>
<%= c.label :company_name, "Firmenname (bei Unternehmen)" %><%= c.text_field :company_name, maxlength: 200 %>
<%= c.label :first_name, "Vorname" %><%= c.text_field :first_name, maxlength: 200 %>
<%= c.label :last_name, "Nachname" %><%= c.text_field :last_name, maxlength: 200 %>
<p>Firmenname oder Vor- und Nachname ausfüllen.</p>
<%= c.label :address, "Anschrift" %><%= c.text_area :address, required: true, maxlength: 1000 %>
<%= c.label :phone, "Telefon" %><%= c.telephone_field :phone, maxlength: 200 %>
<%= c.label :email, "E-Mail-Adresse des Kunden" %><%= c.email_field :email, maxlength: 200 %>
<%= c.label :notes, "Interne Kundenbemerkungen" %><%= c.text_area :notes, maxlength: 4000 %>
<% end %></fieldset>
<fieldset><legend>Angaben für diese Anlage</legend><%= fields_for :customer_membership, @membership do |m| %>
<%= m.label :customer_number, "Kundennummer (optional)" %><%= m.text_field :customer_number, maxlength: 100 %>
<%= m.label :payment_method, "Zahlungsart" %><%= m.select :payment_method, CustomerMembership::PAYMENT_METHODS.to_a %>
<%= m.label :direct_debit_agreement do %><%= m.check_box :direct_debit_agreement %> Lastschriftvereinbarung liegt vor<% end %>
<%= m.label :active do %><%= m.check_box :active %> Kunde in dieser Anlage aktiv<% end %>
<% end %><p>Inaktiv markieren beendet keine bestehenden Verträge. </p></fieldset><%= form.submit "Kunde speichern" %><% end %>
