<%= render "shared/context_errors", record: @reading %><p class="field-hint">Zähler <%= @meter.serial_number %> · kumulativer Stand in <%= @meter.unit %></p>
<%= form_with model: @reading, url: plant_heat_meter_meter_readings_path(@plant, @meter) do |form| %><%= render "shared/context_fields" %><div class="field-grid">
<% if @supersedes %><p class="field--full">Der alte Wert <%= ui_decimal(@supersedes.value) %> bleibt in der Historie erhalten.</p><%= form.hidden_field :supersedes_id, value: @supersedes.id %><% end %>
<%= ui_field(required: true) do %><%= form.label :read_on, "Ablesedatum" %><%= form.date_field :read_on, required: true, readonly: @supersedes.present? %><% end %>
<%= ui_field(required: true) do %><%= form.label :value, "Kumulativer Zählerstand" %><%= form.number_field :value, required: true, min: 0, step: "0.000001" %><% end %>
<%= ui_field do %><%= form.label :kind, "Ableseart" %><%= form.select :kind, (@supersedes ? {"Korrektur" => "correction"} : MeterReading::KINDS.reject { |_label, value| %w[installation removal].include?(value) }).to_a %><% end %>
<%= ui_field(full: true, required: @supersedes.present?) do %><%= form.label :comment, "Kommentar / Begründung bei Korrektur oder Rückgang" %><%= form.text_area :comment, maxlength: 4000, required: @supersedes.present?, rows: 2 %><% end %></div>
<div class="form-actions"><%= form.submit "Ablesung speichern" %><%= link_to "Abbrechen", contextual_path(plant_heat_meter_path(@plant, @meter)) %></div><% end %>
