<%= render "master_data/navigation" %><h1>Vertrag <%= @supply_contract.number %></h1><%= link_to "Vertrag bearbeiten", edit_plant_supply_contract_path(@plant, @supply_contract), class: "button" %>
<section class="panel"><h2>Vertragsdaten</h2><p><%= link_to @supply_contract.customer.display_name, plant_customer_path(@plant, @supply_contract.customer) %></p><p><%= link_to "Anschluss #{@supply_contract.connection.number}", plant_connection_path(@plant, @supply_contract.connection) %></p><p><%= @supply_contract.starts_on %> bis <%= @supply_contract.ends_on || "offen" %> (einschließlich)</p><p><%= SupplyContract::STATUSES.key(@supply_contract.status) %></p><p class="address"><%= @supply_contract.notes %></p><code><%= @supply_contract.id %></code></section><%= render "master_data/history", history: @history %>
