<%= render "shared/page_heading", title: "Anschluss #{@connection.number}", action_label: "Anschluss bearbeiten", action_path: edit_plant_connection_path(@plant, @connection) %>
<%= render "master_data/navigation" %>

<section class="panel"><h2>Anschlussdaten</h2><p class="address"><%= @connection.address %></p><p>Trasse: <%= @connection.route_section&.name || "nicht zugeordnet" %></p><p>Inbetriebnahme: <%= @connection.commissioned_on || "nicht erfasst" %></p><p>Status: <%= Connection::STATUSES.key(@connection.technical_status) %></p><p class="address"><%= @connection.notes %></p><code><%= @connection.id %></code></section>
<section class="panel"><h2>Vertragsgeschichte</h2><%= link_to "Vertrag anlegen", new_plant_supply_contract_path(@plant) %><% @contracts.each do |contract| %><p><%= link_to contract.number, plant_supply_contract_path(@plant, contract) %> · <%= link_to contract.customer.display_name, plant_customer_path(@plant, contract.customer) %> · <%= contract.starts_on %> bis <%= contract.ends_on || "offen" %></p><% end %></section>
<section class="panel"><h2>Wärmezähler und Wechselgeschichte</h2><%= link_to "Zähler einbauen", new_plant_heat_meter_path(@plant, connection_id: @connection.id) %><% @meters.each do |meter| %><p><%= link_to meter.serial_number, plant_heat_meter_path(@plant, meter) %> · <%= meter.installed_on %> bis <%= meter.removed_on || "eingebaut" %></p><% end %></section>
