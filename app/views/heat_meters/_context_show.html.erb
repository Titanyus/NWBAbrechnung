<%= render "shared/page_heading", level: 2, title: "Wärmezähler #{@heat_meter.serial_number}", action_path: edit_plant_heat_meter_path(@plant, @heat_meter, **ui_context_options), action_label: "Zähler bearbeiten" %>
<section class="section"><h2>Einbaugeschichte</h2><dl class="detail-grid"><div><dt>Anschluss</dt><dd><%= link_to @heat_meter.connection.number, plant_connection_path(@plant, @heat_meter.connection, **ui_context_options) %></dd></div><div><dt>Einheit</dt><dd><%= @heat_meter.unit %></dd></div><div><dt>Einbaudatum</dt><dd><%= ui_date(@heat_meter.installed_on) %></dd></div><div><dt>Ausbaudatum</dt><dd><%= ui_date(@heat_meter.removed_on, empty: "eingebaut") %></dd></div><div class="span-all"><dt>Kommentar</dt><dd class="address"><%= @heat_meter.notes.presence || "–" %></dd></div><div class="span-all"><dt>Stabile Zähler-ID</dt><dd><code><%= @heat_meter.id %></code></dd></div></dl></section>
<div class="section-heading"><h2>Ablesungen – kumulative Zählerstände</h2><%= link_to "Ablesung erfassen", new_plant_heat_meter_meter_reading_path(@plant, @heat_meter, **ui_context_options), class: "button" %></div><p class="field-hint">Zählerstände sind keine errechneten Verbräuche. Korrigierte Originalwerte bleiben erhalten.</p>
<%= render layout: "shared/data_table", locals: {table_id: "readings", caption: "Ablesungen und Korrekturhistorie", headers: ["Ablesedatum", "Stand (#{@heat_meter.unit})", "Ableseart", "Status", "Erfasst", "Kommentar", "Aktionen"]} do %>
<% @readings.each do |reading| %><tr class="reading"><td class="date"><%= ui_date(reading.read_on) %></td><td class="number"><%= ui_decimal(reading.value) %></td><td><%= MeterReading::KINDS.key(reading.kind) %></td><td><%= ui_status(reading.superseded_at ? "Historischer, korrigierter Wert" : "Gültiger Wert", tone: reading.superseded_at ? :neutral : :active) %></td><td><span class="date"><%= ui_timestamp(reading.recorded_at) %></span><br><%= reading.recorded_by.email_address %></td><td class="comment"><%= reading.comment %></td><td class="row-actions"><% unless reading.superseded_at %><%= link_to "Ablesung korrigieren", new_plant_heat_meter_meter_reading_path(@plant, @heat_meter, supersedes_id: reading.id, **ui_context_options), class: "action-link", aria: {label: "Ablesung vom #{ui_date(reading.read_on)} korrigieren"} %><% end %></td></tr><% end %><% end %>
<details class="section section--plain"><summary>Zählerhistorie am Hausanschluss</summary><%= render layout: "shared/data_table", locals: {table_id: "meter-history", caption: "Alle Zähler dieses Anschlusses", headers: ["Zählernummer", "Einbau", "Ausbau"]} do %><% @heat_meter.connection.heat_meters.order(installed_on: :desc).each do |meter| %><tr><td><%= link_to meter.serial_number, plant_heat_meter_path(@plant, meter, **ui_context_options) %></td><td class="date"><%= ui_date(meter.installed_on) %></td><td class="date"><%= ui_date(meter.removed_on, empty: "eingebaut") %></td></tr><% end %><% end %></details>
<% unless @heat_meter.removed_on %><details class="section section--plain"><summary>Zählerwechsel oder Ausbau</summary><p><%= link_to "Zähler wechseln", replacement_plant_heat_meter_path(@plant, @heat_meter, **ui_context_options), class: "button" %></p><p class="field-hint">Der geführte Wechsel speichert Schluss- und Anfangswert gemeinsam. Ein reiner Ausbau benötigt einen Schlusswert.</p>
<%= form_with url: retire_plant_heat_meter_path(@plant, @heat_meter) do |form| %><%= render "shared/context_fields" %><div class="field-grid"><%= ui_field(required: true) do %><%= form.label :removed_on, "Ausbaudatum (ohne Nachfolgezähler)" %><%= form.date_field :removed_on, required: true %><% end %><%= ui_field(required: true) do %><%= form.label :closing_value, "Schlusszählerstand" %><%= form.number_field :closing_value, required: true, min: 0, step: "0.000001" %><% end %></div><div class="form-actions"><%= form.submit "Ausbau mit Schlusswert speichern", class: "button--secondary" %></div><% end %></details><% end %>
<%= render "master_data/history", history: @history %>
