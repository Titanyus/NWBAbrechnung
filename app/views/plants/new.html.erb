<%= link_to "← Anlagenübersicht", plants_path %>
<h1>Neue Nahwärmeanlage</h1><p>Die neue Anlage wird Ihnen ausdrücklich zugeordnet. Andere Benutzer erhalten keine automatischen Rechte.</p>
<section class="panel form-panel">
<% if @plant.errors.any? %><div role="alert"><h2>Bitte Angaben prüfen</h2><ul><% @plant.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
<%= form_with model: @plant do |form| %>
  <%= form.label :name, "Name" %><%= form.text_field :name, required: true, maxlength: 150 %>
  <%= form.label :address, "Anschrift" %><%= form.text_area :address, required: true, maxlength: 1000, rows: 3 %>
  <%= form.label :technical_notes, "Technische Hinweise (optional)" %><%= form.text_area :technical_notes, maxlength: 4000, rows: 4 %>
  <%= form.submit "Anlage anlegen" %>
<% end %></section>
