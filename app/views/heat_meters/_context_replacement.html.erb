<% unless local_assigns[:hide_heading] %><%= render "shared/page_heading", level: 2, title: "Zählerwechsel für #{@heat_meter.serial_number}" %><% end %><section class="section form-panel"><%= render "master_data/errors", record: @heat_meter %>
<%= form_with url: exchange_plant_heat_meter_path(@plant, @heat_meter) do |form| %><%= render "shared/context_fields" %><div class="field-grid">
<%= ui_field(required: true) do %><%= form.label :exchange_on, "Wechseldatum" %><%= form.date_field :exchange_on, value: params[:exchange_on], required: true %><% end %>
<%= ui_field(required: true) do %><%= form.label :closing_value, "Schlusszählerstand des alten Zählers" %><%= form.number_field :closing_value, value: params[:closing_value], required: true, min: 0, step: "0.000001" %><% end %>
<%= fields_for :heat_meter, HeatMeter.new(unit: params.dig(:heat_meter, :unit) || @heat_meter.unit) do |m| %>
<%= ui_field(required: true) do %><%= m.label :serial_number, "Zählernummer des neuen Zählers" %><%= m.text_field :serial_number, value: params.dig(:heat_meter, :serial_number), required: true, maxlength: 100 %><% end %>
<%= ui_field do %><%= m.label :unit, "Einheit des neuen Zählers" %><%= m.select :unit, %w[kWh MWh] %><% end %>
<%= ui_field(full: true) do %><%= m.label :notes, "Kommentar zum neuen Zähler" %><%= m.text_area :notes, value: params.dig(:heat_meter, :notes), maxlength: 4000, rows: 2 %><% end %><% end %>
<%= ui_field(required: true) do %><%= form.label :initial_value, "Anfangszählerstand des neuen Zählers" %><%= form.number_field :initial_value, value: params[:initial_value], required: true, min: 0, step: "0.000001" %><% end %></div>
<div class="form-actions"><%= form.submit "Zählerwechsel vollständig speichern" %><%= link_to "Abbrechen", contextual_path(plant_heat_meter_path(@plant, @heat_meter)) %></div><% end %></section>
