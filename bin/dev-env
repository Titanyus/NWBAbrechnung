#!/usr/bin/env python3
"""Generate local synthetic credentials once, never overwrite existing settings."""
import os
import sys
from pathlib import Path
import secrets
path = Path(sys.argv[1] if len(sys.argv) > 1 else '.env')
if not path.exists():
    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    with os.fdopen(fd, 'w') as stream:
        for name, size in [('POSTGRES_PASSWORD', 24), ('SECRET_KEY_BASE', 64), ('DEMO_PASSWORD', 24)]:
            stream.write(name + '=' + secrets.token_hex(size) + '\n')
        stream.write('SESSION_COOKIE_KEY=_nwb_' + secrets.token_hex(6) + '\n')
        stream.write('DEMO_SIZE=small\nNWB_PORT=3000\n')
    print('Lokale Konfiguration angelegt. Demo-Passwort nur dort lesen; nicht veröffentlichen.')
else:
    print('Vorhandene Konfiguration unverändert.')
