<%= render "master_data/navigation" %><h1>Wärmelieferverträge</h1><%= link_to "Vertrag anlegen", new_plant_supply_contract_path(@plant), class: "button" %>
<div class="record-grid"><% @contracts.each do |contract| %><article class="panel"><h2><%= link_to contract.number, plant_supply_contract_path(@plant, contract) %></h2><p><%= contract.customer.display_name %> · Anschluss <%= contract.connection.number %></p><p><%= contract.starts_on %> bis <%= contract.ends_on || "offen" %> · <%= SupplyContract::STATUSES.key(contract.status) %></p></article><% end %></div><%= render "master_data/pagination", records: @contracts %>
