<nav aria-label="Ergebnisseiten">
<%= link_to "← Vorherige Seite", "?#{ request.query_parameters.except("page").merge("page" => @page - 1).to_query }" if @page > 1 %>
<span>Seite <%= @page %> · höchstens 100 Einträge pro Seite</span>
<%= link_to "Nächste Seite →", "?#{ request.query_parameters.except("page").merge("page" => @page + 1).to_query }" if records.length == 100 %>
</nav>
