<%= render "shared/page_heading", title: "Anschlüsse und Verbrauchsstellen", action_label: "Anschluss anlegen", action_path: new_plant_connection_path(@plant) %>
<%= render "master_data/navigation" %>

<%= turbo_frame_tag "connection-results", data: {turbo_action: "replace"} do %>
<%= form_with url: plant_connections_path(@plant), method: :get, id: "connections-search", data: ui_search_data("connection-results") do |form| %><%= form.label :q, "Anschlussnummer oder Adresse suchen" %><%= form.search_field :q, value: params[:q], maxlength: 200 %><%= form.submit "Suchen" %><% end %>
<p role="status"><%= @connections.empty? ? "Keine passenden Anschlüsse gefunden." : "#{@connections.length} Anschlüsse auf dieser Ergebnisseite" %></p>
<div class="record-grid"><% @connections.each do |connection| %><article class="panel"><h2><%= link_to connection.number, plant_connection_path(@plant, connection), data: {turbo_frame: "_top"} %></h2><p class="address"><%= connection.address %></p><p><%= connection.route_section&.name %> · <%= Connection::STATUSES.key(connection.technical_status) %></p></article><% end %></div><%= render "master_data/pagination", records: @connections %>

<% end %>
