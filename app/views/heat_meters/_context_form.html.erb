<%= render "shared/context_errors", record: @heat_meter %>
<%= form_with model: [@plant, @heat_meter] do |form| %><%= render "shared/context_fields" %>
<%= render "fields", form: form %>
<div class="form-actions"><%= form.submit "Zähler speichern" %><%= link_to "Abbrechen", contextual_path(@heat_meter.persisted? ? plant_heat_meter_path(@plant, @heat_meter) : plant_heat_meters_path(@plant)) %></div><% end %>
