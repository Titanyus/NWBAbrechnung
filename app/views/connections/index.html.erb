<%= render "master_data/navigation" %><h1>Anschlüsse und Verbrauchsstellen</h1><%= link_to "Anschluss anlegen", new_plant_connection_path(@plant), class: "button" %>
<%= form_with url: plant_connections_path(@plant), method: :get do |form| %><%= form.label :q, "Anschlussnummer oder Adresse suchen" %><%= form.search_field :q, value: params[:q], maxlength: 200 %><%= form.submit "Suchen" %><% end %>
<div class="record-grid"><% @connections.each do |connection| %><article class="panel"><h2><%= link_to connection.number, plant_connection_path(@plant, connection) %></h2><p class="address"><%= connection.address %></p><p><%= connection.route_section&.name %> · <%= Connection::STATUSES.key(connection.technical_status) %></p></article><% end %></div><%= render "master_data/pagination", records: @connections %>
