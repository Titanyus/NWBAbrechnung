<%= turbo_frame_tag "plants", data: {turbo_action: "replace"} do %>
<%= render "shared/page_heading", title: "Ihre Nahwärmeanlagen", action_label: "Neue Anlage anlegen", action_path: (new_plant_path if current_user.administrator?) %>
<%= form_with url: plants_path, method: :get, id: "plant-search", data: ui_search_data("plants"), class: "toolbar" do |form| %>
<%= ui_field do %><%= form.label :q, "Anlage oder Adresse suchen" %><%= form.search_field :q, value: params[:q], maxlength: 200 %><% end %>
<%= ui_field do %><%= form.label :sort, "Sortierung" %><%= form.select :sort, [["Name (A–Z)", "name"], ["Adresse (A–Z)", "address"]], selected: @sort %><% end %>
<%= form.submit "Suchen" %><% end %>
<p role="status"><strong><%= @total %></strong> berechtigte Anlagen<%= " – keine passenden Anlagen gefunden" if @plants.empty? %></p>
<%= render layout: "shared/data_table", locals: {table_id: "plants-table", caption: "Berechtigte Nahwärmeanlagen", headers: ["Name", "Anschrift", "Hausanschlüsse", "Trassen", "Verträge gesamt", "Gesamtleistung", "Aktionen"]} do %>
<% @plants.each do |plant| %><tr>
<td><%= link_to plant.name, current_user.administrator? ? edit_plant_path(plant) : plant_path(plant), data: {turbo_frame: "_top"} %></td><td class="address"><%= plant.address %></td>
<td class="number"><%= @connection_counts.fetch(plant.id, 0) %></td><td class="number"><%= @route_counts.fetch(plant.id, 0) %></td><td class="number"><%= @contract_counts.fetch(plant.id, 0) %></td><td>nicht erfasst</td>
<td><div class="actions"><%= link_to "Bearbeiten", current_user.administrator? ? edit_plant_path(plant) : plant_path(plant), aria: {label: "#{plant.name}: Bearbeiten"}, data: {turbo_frame: "_top"} %>
<%= form_with url: plant_selection_path, method: :patch, data: {turbo_frame: "_top"} do |form| %><%= form.hidden_field :selected_plant_id, value: plant.id, id: nil %><%= form.hidden_field :area, value: "contracts", id: nil %><%= form.submit "Anlage auswählen", aria: {label: "#{plant.name}: Anlage auswählen"} %><% end %></div></td>
</tr><% end %><% end %>
<%= render "master_data/pagination", records: @plants %>
<p class="field-hint">„Bearbeiten“ öffnet Stammdaten und Trassen. „Anlage auswählen“ öffnet die Vertragsverwaltung. Verträge gesamt umfasst alle Statuswerte.</p>
<% end %>
