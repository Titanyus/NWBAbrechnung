<%= render "shared/page_heading", title: "Kunden anlegen" %>
<%= render "master_data/navigation" %>

<section class="panel form-panel"><%= render "form" %></section>
<%= turbo_frame_tag "available-customers" do %>
<section class="panel form-panel"><h2>Vorhandenen Kunden suchen</h2>
<%= form_with url: new_plant_customer_path(@plant), method: :get, id: "available-customer-search", data: ui_search_data("available-customers") do |form| %><%= form.label :q, "Name eines bereits sichtbaren Kunden" %><%= form.search_field :q, value: params[:q], maxlength: 200 %><%= form.submit "Vorhandene Kunden suchen" %><% end %></section>
<% if @available_customers.any? %><section class="panel form-panel"><h2>Bereits sichtbaren Kunden zuordnen</h2><p>So bleiben die gemeinsamen Stammdaten einmalig gespeichert. Es werden höchstens 100 noch nicht zugeordnete Kunden angezeigt.</p>
<%= form_with url: link_plant_customers_path(@plant), data: {turbo_frame: "_top"} do |form| %><%= form.label :customer_id, "Vorhandener Kunde" %><%= form.select :customer_id, @available_customers.map { |c| [c.display_name, c.id] } %><%= form.submit "Dieser Anlage zuordnen" %><% end %></section><% end %>

<% if @available_customers.empty? %><p role="status">Keine sichtbaren, noch nicht zugeordneten Kunden gefunden.</p><% end %>
<% end %>
