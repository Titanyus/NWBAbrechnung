<%= render "shared/context_errors", record: @plant %>
<%= form_with model: @plant, id: "plant-form", data: {turbo_frame: "_top"} do |form| %>
<div class="field-grid">
<%= ui_field(full: true, required: true) do %><%= form.label :name, "Anlagenname" %><%= form.text_field :name, required: true, maxlength: 150 %><% end %>
<%= render "shared/address_fields", form: form %>
<%= ui_field(full: true) do %><%= form.label :technical_notes, "Technische Hinweise (optional)" %><%= form.text_area :technical_notes, maxlength: 4000, rows: 2 %><% end %>
</div>
<% end %>
